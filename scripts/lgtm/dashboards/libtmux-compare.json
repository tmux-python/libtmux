        "w": 12,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "By branch",
      "collapsed": false,
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
