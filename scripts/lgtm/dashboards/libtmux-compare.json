          "expr": "sum by (vcs_ref_head_name) (increase(tmux_requests_total{tmux_lane=~\"$lane\", vcs_ref_head_name=~\"$branch\", libtmux_spike=~\"$spike\"}[$__range]))",
          "legendFormat": "{{vcs_ref_head_name}}",
